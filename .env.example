# HuggingFace Token (Optional, for gated models/datasets)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases Logging (Optional, defaults to local logging)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=edgetune

# EdgeTune Environment Defaults
EDGETUNE_OUTPUT_DIR=results
EDGETUNE_CACHE_DIR=data/cache
EDGETUNE_DEFAULT_DEVICE=auto
